# Local npm / stdio. Get a key: https://dashboard.exa.ai/api-keys
EXA_API_KEY=

# Comma-separated tools. When set, replaces the defaults.
# Defaults: web_search_exa, web_fetch_exa, plus agent_run when EXA_API_KEY is set
# Optional: web_search_advanced_exa
# Alias: agent_tools → agent_run
# ENABLED_TOOLS=web_search_exa,web_fetch_exa,agent_run

# DEBUG=true
# DEFAULT_SEARCH_TYPE=auto   # auto | fast | instant

# agent_run timing (optional): each call hands back the run ID for resumption
# once the call window passes.
# MCP_MAX_DURATION_SECONDS=800
# AGENT_CALL_WINDOW_MS=45000

# Exa API origin override (optional; defaults to https://api.exa.ai)
# EXA_API_BASE_URL=https://api.exa.ai
