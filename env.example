# Local npm / stdio. Get a key: https://dashboard.exa.ai/api-keys
EXA_API_KEY=

# Comma-separated tools. When set, replaces the defaults.
# Defaults: web_search_exa, web_fetch_exa
# Optional: agent_run, web_search_advanced_exa
# Alias: agent_tools → agent_run
# ENABLED_TOOLS=web_search_exa,web_fetch_exa,agent_run

# DEBUG=true
# DEFAULT_SEARCH_TYPE=auto   # auto | fast | instant

# agent_run timing (optional)
# MCP_MAX_DURATION_SECONDS=800
# AGENT_CALL_WINDOW_MS=750000
